[Desktop Entry]
Name=Equibop
GenericName=Internet Messenger
Comment=Equibop is a Vesktop fork that is a free/libre cross platform desktop app aiming to give you a snappier Discord experience with Equicord pre-installed
Type=Application
Exec=/usr/bin/equibop --enable-features=WebRTCPipeWireCapturer --ozone-platform=wayland --disable-gpu-memory-buffer-video-frames --disable-features=UseChromeOSDirectVideoDecoder
Icon=equibop
Categories=Network;InstantMessaging;
StartupWMClass=equibop
Keywords=discord;equicord;equibop
