{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty",
        "source": "/.config/fastfetch/logos/*",
        "width": 23,
        "height": 10,
        "padding": {
            "top": 6,
            "left": 4
        }
    },
    "display": {
        "separator": " ->  ",
        "color": {
            "separator": "white"
        },
        "constants": [
            "╺╺╺───────────────────────────────  󰆥   󰞇   󰆥   ────────╺╺╺",
            "╺╺╺─────────────────────────────────────────────────────────╺╺╺",
            "│\u001b[65C│\u001b[65D",  
            "\u001b[64C│\u001b[65D",
            "\u001b[64C┇\u001b[65D"
        ],
        "percent": {
            "type": [
                "bar",
                "bar-monochrome"
            ]
        },
        "bar": {
            "border": {
                "left": "\uee00",
                "leftElapsed": "\uee03",
                "right": "\uee02",
                "rightElapsed": "\uee05"
            },
            "char": {
                "total": "\uee01",
                "elapsed": "\uee04"
            },
            "color": {
                "total": null
            }
        },
    },
    "modules": [
        {
            "format": "{#1}{#red}╔{$1}╗\u001b[59D {#keys}[ {user-name}@{host-name} 🖥 ] ",
            "type": "title"
        },
        {
            "type": "os",
            "key": "{$5} OS",
            "keyColor": "red"
        },
        {
            "type": "disk",
            "key": "{$4}│ ├ ",
            "keyColor": "red",
            "format": "{days-of-year} days",
            "folders": "/"
        },
        {
            "type": "packages",
            "key": "{$4}│ ├ ",
            "keyColor": "red"
        },
        {
            "type": "shell",
            "key": "{$4}│ ├ ",
            "keyColor": "red"
        },
        {
            "type": "uptime",
            "key": "{$4}│ └ ",
            "keyColor": "red"
        },
        {
            "type": "wm",
            "key": "{$4} WM",
            "keyColor": "yellow"
        },
        {
            "type": "de",
            "key": "{$4} DE",
            "keyColor": "yellow"
        },
        {
            "type": "command",
            "key": "{$4}│ ├ ",
            "keyColor": "yellow",
            "text": "ls /etc/xdg/quickshell/ | head -1"
        },
        {
            "type": "icons",
            "key": "{$4}│ ├ ",
            "keyColor": "yellow",
            "format": "{icons1}"
        },
        {
            "type": "font",
            "key": "{$4}│ ├ ",
            "keyColor": "yellow",
            "format": "{font1}"
        },
        {
            "type": "terminal",
            "key": "{$4}│ ├ ",
            "keyColor": "yellow"
        },
        {
            "type": "command",
            "key": "{$4}│ └ ",
            "keyColor": "yellow",
            "text": "playerctl metadata --format '[󰒮 {{status}} 󰒭] {{artist}} - {{title}}' | sed 's/Playing/󰐊/;s/Paused/󰏤/;s/Stopped/󰓛/'"
        },
        {
            "type": "custom",
            "format": "{$4}{#green} Hardware                                                      │"
        },
        {
            "type": "cpu",
            "key": "{$4}│ ├ ",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "{$4}│ ├󰾲 ",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "{$4}│ └ ",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "format": "{$4}{#blue}󰋊 Disks                                                         │"
        },
        {
            "type": "disk",
            "key": "{$4}│ ├  [{name}]",
            "keyColor": "blue",
            "format": "{size-percentage-bar} {size-used} / {size-total}",
            "folders": "/" 
        },
        {
            "type": "disk",
            "key": "{$4}│ ├  [{name}]",
            "keyColor": "blue",
            "format": "{size-percentage-bar} {size-used} / {size-total}",
            "folders": "/mnt/extrastuff1",
            "hideFS": "autofs"
        },
        {
            "type": "disk",
            "key": "{$5}┇ ├  [{name}]",
            "keyColor": "blue",
            "format": "{size-percentage-bar} {size-used} / {size-total}",
            "folders": "/mnt/extrastuff2",
            "hideFS": "autofs"
        },
        {
            "format": "{#blue}╠{$2}╣",
            "type": "custom"
        },
        {
            "type": "colors",
            "key": "{$5} colors",
            "keyColor": "white",
            "symbol": "circle"
        },
        {
            "format": "{#blue}╚{$1}╝",
            "type": "custom"
        }
    ]
}
