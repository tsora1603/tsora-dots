{
  "systemCmd": "checkupdates 2>/dev/null",
  "aurCmd": "paru -Qua 2>/dev/null",
  "updateCmd": "kitty -T arch-update -e arch-update",
  "flatpak": true,
  "noctalia": true,
  "toast": true,
  "desktopTip": true,
  "hideOnEmpty": false,
  "refreshTimer": true,
  "refreshInterval": 120,
  "iconName": "arrow-big-down-lines",
  "useDistroLogo": false,
  "customIconPath": "",
  "boldText": true,
  "enableColorization": false,
  "iconColor": "none",
  "boldVer": true,
  "tooltip": true,
  "closeButton": false,
  "boldVerPanel": true,
  "boldVerDesktop": true,
  "hoverTip": true,
  "checkCmd": "(checkupdates; paru -Qua) 2>/dev/null",
  "nameCmd": "(checkupdates; paru -Qua;) | awk '{print $1}'",
  "oldVerCmd": "(checkupdates; paru -Qua;) | awk '{print $2}'",
  "newVerCmd": "(checkupdates; paru -Qua;) | awk '{print $4}'"
}
