layout {

    focus-ring {
        active-color   "#c34c22"
        inactive-color "#eee2dd"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#c34c22"
        inactive-color "#eee2dd"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#d4c8c470"
    }

    tab-indicator {
        active-color   "#c34c22"
        inactive-color "#e6bfb2"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#c34c2280"
    }
}

recent-windows {
    highlight {
        active-color "#c34c22"
        urgent-color "#fd4663"
    }
}
